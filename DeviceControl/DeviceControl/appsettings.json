{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Db;Username=postgres;Password=123456;"
  },
  "AppSettings": {
    "IsDebug": true, //是否开启调试模式,配置为false，程序启动后会默认隐藏主窗体，只在底部托盘显示图标
    "IsStartUp": false, //是否开机自启动
    "PingIp": "192.168.9.10",
    "Station": {
      "Title": "设备控制", //程序名称
      "LineClass": "内饰一线",
      "LineName": "内饰一线",
      "LineCode": "T1",
      "StationID": "OnLineT1",
      "StationName": "OnLineT1",
      "ClientCode": "OnLineT1TETST" //客户端ID
    },
    "DeviceConfig": {
      "ColorLampConfig": {
        "DeviceId": "1",
        "FriendlyName": "ONN三色灯",
        "Available": true,
        "DeviceType": "ONNA2_LampDevice", //1 = QLight_LampDevice 2= ONN_LampDevice 3=ONNA2_LampDevice
        "PortName": "COM10", //COM7
        "LightHouseNumber": 3, //灯塔层数
        "BaudRate": 9600
      },
      "ScanConfig": {
        "DeviceId": "ScanDevice",
        "FriendlyName": "扫码枪",
        "Available": false,
        "DeviceType": "SerialScanDevice",
        "PortName": "COM1",
        "BaudRate": 9600, //波特率
        "DataBits": 8, //数据位
        "Parity": "None", //校验位
        "StopBits": "1" //停止位
      },
      "SwipeCardConfig": {
        "DeviceId": "SwipeCardDevice",
        "FriendlyName": "刷卡器",
        "Available": false, //true, false,
        "DeviceType": "WenXinCard", //SerialScanDevice
        "Port": "COM3", //COM3
        "BaudRate": 9600, //波特率
        "DataBits": 8, //数据位
        "Parity": "None", //校验位
        "StopBits": "1" //停止位 
      },
      "ProximitySwitchModuleConfig": [
        {
          "DeviceId": "ProximitySwitch_0",
          "FriendlyName": "接近开关_1",
          "Available": true, 
          "DeviceType": "ProximitySwitchModule",
          "Ip": "127.0.0.1", 
          "Port": "504", 
          "DelayTime": 100 
        }
      ]
    },
    "AppServerConfig": {
      "ServerPort": 9999,
      "Origins": [ //跨域配置
        "http://localhost:8080",
        "http://localhost",
        "http://localhost:5173"
      ]
    }
  },
  "MQTTConfig": [
    {
      "Name": "MQTT_1",
      "MqttHost": "127.0.0.1",
      "MqttPort": 1883,
      "MqttUserName": "admin",
      "MqttPwd": "admin"
    },
    {
      "Name": "MQTT_2",
      "MqttHost": "127.0.0.1",
      "MqttPort": 1883,
      "MqttUserName": "admin",
      "MqttPwd": "admin"
    }
  ],
  "DeviceTypeItemsSource": {
    "ColorLampConfig": [
      "ONN_LampDevice",
      "QLight_LampDevice",
      "Schneider_LampDevice",
      "ONNA2_LampDevice"
    ],
    "ScanConfig": [
      "SerialScanDevice"
    ],
    "SwipeCardConfig": [
      "WenXinCard"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.OpenObserve-KKP" ], // Enable OpenObserve-KKP sink
    "MinimumLevel": "Verbose", // General minimum level of Serilog
    "WriteTo": [
      {
        "Name": "OpenObserve", // Name of this sink, don't change
        "Args": {
          "url": "http://localhost:5080/api/default/v1/logs",
          "organization": "default",
          "login": "root@163.com",
          "key": "qwer1234....",
          "streamName": "DeviceControlClient", // Optional
          "restrictedToMinimumLevel": "Verbose" // Optional
        }
      }
    ],
    "Properties": {
      "Application": "OnLineT3"
    }
  }

}