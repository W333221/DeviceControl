<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:be="clr-namespace:DeviceControl.Behavior"
    xmlns:converters="clr-namespace:DeviceControl.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DeviceControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DeviceControl.ViewModels.Config">

    <converters:ObjectToIntConverter x:Key="ObjectToIntConverter" />
    <converters:BoolToRadioConverter x:Key="BoolToRadioConverter" />
    <be:PasswordBoxBehavior x:Key="PasswordBoxBehavior" />

    <!--  文本框模板  -->
    <DataTemplate x:Key="TextBoxTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="{DynamicResource TextLargeFontSize}"
                Text="{Binding Label}"
                ToolTip="{Binding Desc}" />
            <hc:TextBox
                Grid.Column="1"
                Height="40"
                VerticalAlignment="Center"
                Text="{Binding CurrentValue}" />
        </Grid>
    </DataTemplate>

    <!--  单选按钮组模板  -->

    <DataTemplate x:Key="RadioTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="{DynamicResource TextLargeFontSize}"
                Text="{Binding Label}"
                ToolTip="{Binding Desc}" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <RadioButton
                    Height="40"
                    Margin="5"
                    Content="True"
                    IsChecked="{Binding CurrentValue, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=True}" />
                <RadioButton
                    Height="40"
                    Margin="5"
                    Content="False"
                    IsChecked="{Binding CurrentValue, Converter={StaticResource BoolToRadioConverter}, ConverterParameter=False}" />
            </StackPanel>
        </Grid>
    </DataTemplate>


    <!--  数字输入框模板  -->

    <DataTemplate x:Key="NumericTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="{DynamicResource TextLargeFontSize}"
                Text="{Binding Label}"
                ToolTip="{Binding Desc}" />
            <hc:NumericUpDown
                Grid.Column="1"
                Height="40"
                VerticalAlignment="Center"
                FontSize="{DynamicResource TextLargeFontSize}"
                Value="{Binding CurrentValue, Converter={StaticResource ObjectToIntConverter}, Mode=TwoWay}" />
        </Grid>
    </DataTemplate>


    <!--  密码输入框模板  -->

    <DataTemplate x:Key="PasswordBoxTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="{DynamicResource TextLargeFontSize}"
                Text="{Binding Label}"
                ToolTip="{Binding Desc}" />

            <!--<PasswordBox
                Grid.Column="1"
                Height="40"
                be:PasswordBoxHelper.Password="{Binding CurrentValue, Mode=TwoWay}"
                FontSize="{DynamicResource TextLargeFontSize}">
                <i:Interaction.Behaviors>
                    <be:PasswordBoxBehavior />
                </i:Interaction.Behaviors>
            </PasswordBox>-->

            <hc:PasswordBox
                Grid.Column="1"
                Height="40"
                FontSize="{DynamicResource TextLargeFontSize}"
                IsSafeEnabled="False"
                ShowEyeButton="True"
                UnsafePassword="{Binding CurrentValue}" />

        </Grid>
    </DataTemplate>



    <!--  下拉框模板  -->

    <DataTemplate x:Key="ComboBoxTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="{DynamicResource TextLargeFontSize}"
                Text="{Binding Label}"
                ToolTip="{Binding Desc}" />

            <ComboBox
                Grid.Column="1"
                Height="40"
                DisplayMemberPath="."
                ItemsSource="{Binding ItemsSource}"
                SelectedItem="{Binding CurrentValue, Mode=TwoWay}" />
        </Grid>
    </DataTemplate>

    <!--  注册模板选择器  -->

    <vm:FieldTemplateSelector
        x:Key="FieldSelector"
        ComboBoxTemplate="{StaticResource ComboBoxTemplate}"
        NumericTemplate="{StaticResource NumericTemplate}"
        PasswordBoxTemplate="{StaticResource PasswordBoxTemplate}"
        RadioTemplate="{StaticResource RadioTemplate}"
        TextBoxTemplate="{StaticResource TextBoxTemplate}" />

</ResourceDictionary> 