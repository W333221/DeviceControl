<UserControl
    x:Class="DeviceControl.Views.ModbusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DeviceControl.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ModbusPageViewModel}"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!--  区域1：连接配置  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="12"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="IP地址:" />
                <TextBox
                    Grid.Column="1"
                    hc:InfoElement.Placeholder="127.0.0.1"
                    Text="{Binding IpAddress}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="12,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="端口:" />
                <TextBox
                    Grid.Column="3"
                    hc:InfoElement.Placeholder="502"
                    Text="{Binding Port}" />

                <TextBlock
                    Grid.Column="4"
                    Margin="12,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="从站ID:" />
                <TextBox
                    Grid.Column="5"
                    hc:InfoElement.Placeholder="1"
                    Text="{Binding SlaveId}" />

                <StackPanel
                    Grid.Column="6"
                    Margin="24,0,12,0"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{Binding StatusColor}" />
                    <Button
                        Width="70"
                        Height="30"
                        Command="{Binding ConnectCommand}"
                        Content="{Binding ConnectButtonText}" />
                </StackPanel>

                <hc:LoadingLine
                    Grid.Column="7"
                    Width="50"
                    HorizontalAlignment="Right"
                    IsRunning="{Binding IsLoading}" />
            </Grid>
        </Border>

        <!--  区域2：读写操作区  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：读取区  -->
            <Border
                Grid.Column="0"
                Padding="12"
                Background="{DynamicResource RegionBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="读取操作" />
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="功能码:" />
                        <ComboBox
                            Grid.Column="1"
                            Margin="6,0"
                            SelectedValue="{Binding ReadFunctionCode}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="FC1 线圈" Tag="1" />
                            <ComboBoxItem Content="FC2 离散输入" Tag="2" />
                            <ComboBoxItem Content="FC3 保持寄存器" Tag="3" />
                            <ComboBoxItem Content="FC4 输入寄存器" Tag="4" />
                        </ComboBox>
                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="地址:" />
                        <TextBox
                            Grid.Column="3"
                            Margin="6,0"
                            Text="{Binding ReadStartAddress}" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="数量:" />
                        <TextBox
                            Grid.Column="5"
                            Margin="6,0"
                            Text="{Binding ReadQuantity}" />
                        <Button
                            Grid.Column="6"
                            Width="60"
                            Height="28"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ReadCommand}"
                            Content="读取" />
                    </Grid>
                    <DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding ReadResults}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Address}"
                                Header="地址" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Value}"
                                Header="值" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!--  右侧：写入区  -->
            <Border
                Grid.Column="2"
                Padding="12"
                Background="{DynamicResource RegionBrush}"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="写入操作" />
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="功能码:" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            SelectedValue="{Binding WriteFunctionCode}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="FC5 写单线圈" Tag="5" />
                            <ComboBoxItem Content="FC6 写单寄存器" Tag="6" />
                            <ComboBoxItem Content="FC15 写多线圈" Tag="15" />
                            <ComboBoxItem Content="FC16 写多寄存器" Tag="16" />
                        </ComboBox>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="地址:" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            Text="{Binding WriteStartAddress}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,6,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Text="写入值:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Margin="6,6,12,0"
                            hc:InfoElement.Placeholder="单个值直接输入，多个值用逗号分隔"
                            Text="{Binding WriteValue}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="4"
                            Width="60"
                            Height="28"
                            Margin="6,0,0,0"
                            VerticalAlignment="Bottom"
                            Command="{Binding WriteCommand}"
                            Content="写入" />
                    </Grid>
                    <Border
                        Grid.Row="2"
                        Padding="8"
                        Background="#1AFFFFFF"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                            <Run Text="FC5: 写单线圈 (ON/OFF 或 1/0)" /><LineBreak />
                            <Run Text="FC6: 写单寄存器 (十进制数值)" /><LineBreak />
                            <Run Text="FC15: 写多线圈 (ON,OFF,ON...)" /><LineBreak />
                            <Run Text="FC16: 写多寄存器 (100,200,300...)" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  区域3：通信日志  -->
        <Border
            Grid.Row="2"
            Padding="12"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="通信日志" />
                    <Button
                        Width="70"
                        Height="26"
                        Command="{Binding ClearLogCommand}"
                        Content="清空"
                        DockPanel.Dock="Right" />
                </DockPanel>
                <ListBox
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="{DynamicResource SubHeadFontSize}"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    ItemsSource="{Binding CommunicationLogs}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="2,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
