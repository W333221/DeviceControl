<UserControl
    x:Class="DeviceControl.Views.Config.Config_MQTT"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceControl.Views.Config"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  API配置  -->
        <Border Margin="10" CornerRadius="10">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource RegionColor}" />
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Opacity="0.5" Color="{DynamicResource SecondaryBorderColor}" />
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness
                    Bottom="1"
                    Left="1"
                    Right="1"
                    Top="1" />
            </Border.BorderThickness>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <hc:ScrollViewer Grid.Column="1">
                    <StackPanel Orientation="Vertical">
                        <ItemsControl ItemsSource="{Binding MQTTConfigs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50" />
                                            <RowDefinition Height="50" />
                                            <RowDefinition Height="50" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            Text="名称：" />
                                        <hc:TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            Text="服务器地址：" />
                                        <hc:TextBox
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Text="{Binding MqttHost}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            Text="端口：" />

                                        <hc:NumericUpDown
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            Value="{Binding MqttPort}" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            Text="用户名：" />
                                        <hc:TextBox
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Height="40"
                                            VerticalAlignment="Center"
                                            Text="{Binding MqttUserName}" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            Text="密码：" />


                                        <hc:PasswordBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Height="40"
                                            FontSize="{DynamicResource TextLargeFontSize}"
                                            IsSafeEnabled="False"
                                            ShowEyeButton="True"
                                            UnsafePassword="{Binding MqttPwd}" />

                                        <!--<PasswordBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Height="40"
                                            be:PasswordBoxHelper.Password="{Binding MqttPwd, Mode=TwoWay}"
                                            FontSize="{DynamicResource TextLargeFontSize}">
                                            <i:Interaction.Behaviors>
                                                <be:PasswordBoxBehavior />
                                            </i:Interaction.Behaviors>
                                        </PasswordBox>-->
                                        <hc:Divider
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="4"
                                            Margin="1,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </hc:ScrollViewer>

                <Grid Grid.Row="1" Grid.Column="1">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            MinWidth="100"
                            MinHeight="40"
                            Margin="10,0,10,0"
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderThickness="0"
                            Command="{Binding AddCommand}"
                            Content="新增"
                            FontSize="{DynamicResource TextLargeFontSize}"
                            Foreground="{DynamicResource TextIconBrush}" />
                        <Button
                            MinWidth="100"
                            MinHeight="40"
                            Margin="10,0,10,0"
                            Padding="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderThickness="0"
                            Command="{Binding SaveMQTTCommand}"
                            Content="保存"
                            FontSize="{DynamicResource TextLargeFontSize}"
                            Foreground="{DynamicResource TextIconBrush}" />

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
