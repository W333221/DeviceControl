<UserControl
    x:Class="DeviceControl.Views.Config.Config"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:DeviceControl.Views.Config"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DeviceControl.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Border Background="{DynamicResource RegionBrush}" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Height="45" Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="18"
                        Height="18"
                        Margin="0,0,6,0"
                        Data="{StaticResource SearchGeometry}"
                        Fill="{DynamicResource PrimaryTextBrush}"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource SubHeadFontSize}"
                        Text="系统配置" />
                    <Path
                        Width="20"
                        Height="20"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        Data="{DynamicResource Icon.Language}"
                        Fill="{DynamicResource PrimaryTextBrush}"
                        Opacity="0.75"
                        Stretch="Uniform">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeftButtonDown">
                                <i:InvokeCommandAction Command="{Binding ChangeLanguageCommand}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Path>
                </StackPanel>
            </Border>
            <hc:Divider Grid.Row="1" Margin="10,0" />

            <hc:TabControl
                Grid.Row="3"
                IsScrollable="True"
                ShowOverflowButton="False">
                <hc:TabItem Header="基础配置" IsSelected="True">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <local:Config_Station />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="设备配置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <local:Config_Device />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="更新配置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <local:Config_Update />
                    </hc:SimplePanel>
                </hc:TabItem>
                <hc:TabItem Header="MQTT配置">
                    <hc:SimplePanel Background="{DynamicResource RegionBrush}">
                        <local:Config_MQTT />
                    </hc:SimplePanel>
                </hc:TabItem>
            </hc:TabControl>
        </Grid>
    </Border>
</UserControl>
