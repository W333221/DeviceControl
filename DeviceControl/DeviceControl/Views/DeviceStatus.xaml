<UserControl
    x:Class="DeviceControl.Views.DeviceStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceControl.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <StackPanel
        Margin="14"
        Background="{DynamicResource RegionBrush}"
        Orientation="Horizontal">
        <ItemsControl BorderThickness="0" ItemsSource="{Binding DeviceConnectStatuses}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{DynamicResource SubHeadFontSize}"
                            Text="{Binding Name}" />
                        <Path
                            Width="25"
                            Height="25"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource Icon.Status}"
                            Fill="{Binding Status, Converter={StaticResource BoolToColorConverter}}"
                            Stretch="Uniform"
                            Stroke="{Binding Status, Converter={StaticResource BoolToColorConverter}}" />
                        <Button
                            Margin="0,0,10,0"
                            Padding="4"
                            hc:IconElement.Geometry="{DynamicResource Icon.Refresh}"
                            hc:IconElement.Height="22"
                            hc:IconElement.Width="22"
                            BorderThickness="0"
                            Command="{Binding ReconnectCommand}" />
                        <hc:Divider LineStrokeThickness="2" Orientation="Vertical" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
